# Content Delivery API (read) — required for fetch
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=
# Content Preview API — only required for `fetch --preview` (draft entries)
CONTENTFUL_PREVIEW_TOKEN=
CONTENTFUL_ENVIRONMENT_ID=master
CONTENTFUL_LOCALE=en-US

# Content Management API (write) — only required for `apply --write`
CONTENTFUL_MANAGEMENT_TOKEN=
